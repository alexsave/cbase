AWSTemplateFormatVersion: "2010-09-09"
# The vm group g4, made by ./cbase group-init (tools/cbase.d/group.sh). Edits by hand are drift.
Description: "cbase vm group g4: the instance its apps run on, dual-stack"

Parameters:
  InstanceType:
    Type: String
    Description: an arm64 (Graviton) instance type; cbase builds its servers for linux arm64
  ImageId:
    Type: AWS::EC2::Image::Id
    Description: the Amazon Linux 2023 arm64 image the group was first made with (/aws/service/ami-amazon-linux-latest/al2023-ami-kernel-default-arm64)
  AvailabilityZone:
    Type: AWS::EC2::AvailabilityZone::Name
    Description: the subnet's zone, one that offers the instance type (group-init picks it)
  CloudFrontPrefixList:
    Type: String
    Description: CloudFront's IPv6 origin-facing managed prefix list (com.amazonaws.global.ipv6.cloudfront.origin-facing) in this region
    AllowedPattern: "pl-[0-9a-f]+"
  CloudFrontPrefixListIpv4:
    Type: String
    Description: CloudFront's IPv4 origin-facing managed prefix list (com.amazonaws.global.cloudfront.origin-facing) in this region
    AllowedPattern: "pl-[0-9a-f]+"
  ArtifactBucket:
    Type: String
    Description: the state bucket, whose artifacts/ the instance reads its apps' servers from

Resources:
  # The group's own network: a VPC with an Amazon-provided IPv6 /56 and one subnet, an internet
  # gateway and a ::/0 route. The subnet is dual-stack (--ipv4), its IPv4 the Elastic IP's.
  Vpc:
    Type: AWS::EC2::VPC
    Properties:
      CidrBlock: 10.0.0.0/24   # EC2 requires one; the subnet's
      EnableDnsSupport: true
      EnableDnsHostnames: true
      Tags:
        - Key: Name
          Value: cbase-vm-g4
  VpcIpv6:
    Type: AWS::EC2::VPCCidrBlock
    Properties:
      VpcId: !Ref Vpc
      AmazonProvidedIpv6CidrBlock: true
  Igw:
    Type: AWS::EC2::InternetGateway
    Properties:
      Tags:
        - Key: Name
          Value: cbase-vm-g4
  IgwAttach:
    Type: AWS::EC2::VPCGatewayAttachment
    Properties:
      VpcId: !Ref Vpc
      InternetGatewayId: !Ref Igw
  Subnet:
    Type: AWS::EC2::Subnet
    DependsOn: VpcIpv6
    Properties:
      VpcId: !Ref Vpc
      AvailabilityZone: !Ref AvailabilityZone
      CidrBlock: 10.0.0.0/24
      MapPublicIpOnLaunch: false   # the Elastic IP is its public IPv4
      Ipv6CidrBlock: !Select [0, !Cidr [!Select [0, !GetAtt Vpc.Ipv6CidrBlocks], 1, 64]]
      AssignIpv6AddressOnCreation: true
      PrivateDnsNameOptionsOnLaunch:
        HostnameType: resource-name
        EnableResourceNameDnsAAAARecord: true
      Tags:
        - Key: Name
          Value: cbase-vm-g4
  RouteTable:
    Type: AWS::EC2::RouteTable
    Properties:
      VpcId: !Ref Vpc
      Tags:
        - Key: Name
          Value: cbase-vm-g4
  DefaultRoute6:
    Type: AWS::EC2::Route
    DependsOn: IgwAttach
    Properties:
      RouteTableId: !Ref RouteTable
      DestinationIpv6CidrBlock: ::/0
      GatewayId: !Ref Igw
  DefaultRoute4:
    Type: AWS::EC2::Route
    DependsOn: IgwAttach
    Properties:
      RouteTableId: !Ref RouteTable
      DestinationCidrBlock: 0.0.0.0/0
      GatewayId: !Ref Igw
  SubnetRoutes:
    Type: AWS::EC2::SubnetRouteTableAssociation
    Properties:
      SubnetId: !Ref Subnet
      RouteTableId: !Ref RouteTable

  Role:
    Type: AWS::IAM::Role
    Properties:
      Description: cbase vm group g4's instance
      AssumeRolePolicyDocument:
        Version: "2012-10-17"
        Statement:
          - Effect: Allow
            Principal:
              Service: ec2.amazonaws.com
            Action: sts:AssumeRole
      ManagedPolicyArns:
        - !Sub "arn:${AWS::Partition}:iam::aws:policy/AmazonSSMManagedInstanceCore"
      Policies:
        - PolicyName: cbase-apps
          PolicyDocument:
            Version: "2012-10-17"
            Statement:
              - Sid: TheAppsServers
                Effect: Allow
                Action: s3:GetObject
                Resource: !Sub "arn:${AWS::Partition}:s3:::${ArtifactBucket}/artifacts/*"
              # The apps' backups (serve's CBASE_BACKUP_*): s3://<state bucket>/backups/, and no
              # other key of the bucket. One role serves every app of the group, and any process on
              # the instance can read its credentials from IMDS, so a per-app prefix in IAM would
              # not hold one app from another: the boundary between apps is their Unix users.
              - Sid: TheAppsBackups
                Effect: Allow
                Action: [s3:GetObject, s3:PutObject]
                Resource: !Sub "arn:${AWS::Partition}:s3:::${ArtifactBucket}/backups/*"
              - Sid: TheAppsBackupsList
                Effect: Allow
                Action: s3:ListBucket
                Resource: !Sub "arn:${AWS::Partition}:s3:::${ArtifactBucket}"
                Condition:
                  StringLike:
                    s3:prefix: "backups/*"
              - Sid: TheAppsSettings
                Effect: Allow
                Action: ssm:GetParametersByPath
                Resource: !Sub "arn:${AWS::Partition}:ssm:${AWS::Region}:${AWS::AccountId}:parameter/cbase/*"
              # The boot's claim of the fixed address (vm_boot.sh), on an interface of this subnet alone.
              - Sid: TheFixedAddress
                Effect: Allow
                Action: ec2:AssignIpv6Addresses
                Resource: !Sub "arn:${AWS::Partition}:ec2:${AWS::Region}:${AWS::AccountId}:network-interface/*"
                Condition:
                  ArnEquals:
                    ec2:Subnet: !Sub "arn:${AWS::Partition}:ec2:${AWS::Region}:${AWS::AccountId}:subnet/${Subnet}"

  Profile:
    Type: AWS::IAM::InstanceProfile
    Properties:
      Roles: [!Ref Role]

  SecurityGroup:
    Type: AWS::EC2::SecurityGroup
    Properties:
      GroupDescription: cbase vm group g4 - the app ports 8700-8799 from CloudFront (IPv6) alone
      VpcId: !Ref Vpc
      SecurityGroupIngress:
        - IpProtocol: tcp
          FromPort: 8700
          ToPort: 8799
          SourcePrefixListId: !Ref CloudFrontPrefixList
          Description: CloudFront IPv6 origin-facing addresses to the app ports
      SecurityGroupEgress:
        - IpProtocol: "-1"
          CidrIpv6: ::/0
          Description: all egress (IPv6)
        - IpProtocol: "-1"
          CidrIp: 0.0.0.0/0
          Description: all egress (IPv4)
  SecurityGroupIpv4:
    Type: AWS::EC2::SecurityGroup
    Properties:
      GroupDescription: cbase vm group g4 - the app ports 8700-8799 from CloudFront (IPv4) alone
      VpcId: !Ref Vpc
      SecurityGroupIngress:
        - IpProtocol: tcp
          FromPort: 8700
          ToPort: 8799
          SourcePrefixListId: !Ref CloudFrontPrefixListIpv4
          Description: CloudFront IPv4 origin-facing addresses to the app ports

  LaunchTemplate:
    Type: AWS::EC2::LaunchTemplate
    Properties:
      LaunchTemplateData:
        MetadataOptions:
          HttpTokens: required
          HttpEndpoint: enabled
          HttpProtocolIpv6: enabled
          HttpPutResponseHopLimit: 1
        BlockDeviceMappings:
          - DeviceName: /dev/xvda
            Ebs:
              VolumeSize: 8
              VolumeType: gp3
              Encrypted: true
              DeleteOnTermination: true

  Instance:
    Type: AWS::EC2::Instance
    DependsOn: [DefaultRoute6, DefaultRoute4, SubnetRoutes]
    Properties:
      ImageId: !Ref ImageId
      InstanceType: !Ref InstanceType
      IamInstanceProfile: !Ref Profile
      NetworkInterfaces:
        - DeviceIndex: "0"
          SubnetId: !Ref Subnet
          GroupSet: [!GetAtt SecurityGroup.GroupId, !GetAtt SecurityGroupIpv4.GroupId]
          # A random address of the subnet: the boot claims the fixed one (OriginIpv6) itself.
          Ipv6AddressCount: 1
          AssociatePublicIpAddress: false
          DeleteOnTermination: true
      LaunchTemplate:
        LaunchTemplateId: !Ref LaunchTemplate
        Version: !GetAtt LaunchTemplate.LatestVersionNumber
      UserData:
        Fn::Base64: !Sub
          - |
            #!/bin/bash
            set -eEuo pipefail
            exec > >(tee -a /var/log/cbase-vm-boot.log | logger -t cbase-vm-boot) 2>&1
            trap 'echo "cbase-vm-boot: failed at line $LINENO"' ERR
            umask 077
            self=/var/lib/cloud/scripts/per-boot/cbase-vm-boot
            [ "$0" = "$self" ] || install -D -m 0700 "$0" "$self"
            want='${OriginIpv6}'
            imds=""
            for a in 'http://[fd00:ec2::254]' http://169.254.169.254; do
              if tok="$(curl -sSf --max-time 2 -X PUT "$a/latest/api/token" -H 'X-aws-ec2-metadata-token-ttl-seconds: 300' 2> /dev/null)"; then imds="$a"; break; fi
            done
            [ -n "$imds" ] || { echo "cbase-vm-boot: no instance metadata service answered (IMDSv2, over IPv6 or IPv4)"; exit 1; }
            md() { curl -sSf -H "X-aws-ec2-metadata-token: $tok" "$imds/latest/$1"; }
            region="$(md meta-data/placement/region)"
            role="$(md meta-data/iam/security-credentials/)"
            creds="$(md "meta-data/iam/security-credentials/$role")"
            field() { python3 -c 'import json,sys; print(json.load(sys.stdin)[sys.argv[1]])' "$1"; }
            ak="$(field AccessKeyId <<< "$creds")"
            sk="$(field SecretAccessKey <<< "$creds")"
            st="$(field Token <<< "$creds")"
            mac="$(md meta-data/mac)"
            eni="$(md "meta-data/network/interfaces/macs/$mac/interface-id")"
            have() { md "meta-data/network/interfaces/macs/$mac/ipv6s" | python3 -c '
            import ipaddress, sys
            w = ipaddress.ip_address(sys.argv[1]); sys.exit(0 if any(ipaddress.ip_address(l.strip()) == w for l in sys.stdin if l.strip()) else 1)' "$want"; }
            for _ in $(seq 1 30); do
              have && break
              curl -sSf --aws-sigv4 "aws:amz:$region:ec2" --user "$ak:$sk" -H "x-amz-security-token: $st" -o /dev/null \
                --data "Action=AssignIpv6Addresses&Version=2016-11-15&NetworkInterfaceId=$eni&Ipv6Addresses.1=$want" \
                "https://ec2.$region.api.aws/" || true
              sleep 10
            done
            have || { echo "cbase-vm-boot: could not claim $want"; exit 1; }
            dev="$(ip -o link | awk -F': ' -v m="$mac" '$0 ~ m { print $2; exit }')"
            ip -6 addr replace "$want/128" dev "$dev"
            echo "cbase-vm-boot: address $want on $dev"
            conf=/etc/amazon/ssm/amazon-ssm-agent.json
            drop=/etc/systemd/system/amazon-ssm-agent.service.d/ipv6.conf
            mkdir -p /etc/amazon/ssm "$(dirname "$drop")"
            printf '{"Agent":{"Region":"%s","UseDualStackEndpoint":true},"Ssm":{"Endpoint":"ssm.%s.api.aws"},"Mgs":{"Region":"%s","Endpoint":"ssmmessages.%s.api.aws"},"S3":{"Region":"%s","Endpoint":"s3.dualstack.%s.amazonaws.com"}}\n' \
              "$region" "$region" "$region" "$region" "$region" "$region" > "$conf.new"
            printf '[Service]\nEnvironment=AWS_EC2_METADATA_SERVICE_ENDPOINT_MODE=IPv6\nEnvironment=AWS_USE_DUALSTACK_ENDPOINT=true\n' > "$drop.new"
            if cmp -s "$conf.new" "$conf" && cmp -s "$drop.new" "$drop"; then
              rm -f "$conf.new" "$drop.new"
            else
              chmod 0644 "$conf.new" "$drop.new"
              mv -f "$conf.new" "$conf"
              mv -f "$drop.new" "$drop"
              systemctl daemon-reload
              systemctl enable amazon-ssm-agent
              systemctl restart amazon-ssm-agent
              echo "cbase-vm-boot: the SSM agent is on the dual-stack endpoints"
            fi
          - OriginIpv6: !Select [0, !Split ["/", !Select [1, !Cidr [!Select [0, !GetAtt Subnet.Ipv6CidrBlocks], 2, 4]]]]
      Tags:
        - Key: cbase:vm-group
          Value: g4
        - Key: Name
          Value: cbase-vm-g4

  Address:
    Type: AWS::EC2::EIP
    DependsOn: IgwAttach
    Properties:
      Domain: vpc
      InstanceId: !Ref Instance

Outputs:
  InstanceId:
    Value: !Ref Instance
  OriginIpv6:
    Description: the fixed IPv6 address the instance claims at boot, the subnet's ::10 (its AAAA record's)
    Value: !Select [0, !Split ["/", !Select [1, !Cidr [!Select [0, !GetAtt Subnet.Ipv6CidrBlocks], 2, 4]]]]
