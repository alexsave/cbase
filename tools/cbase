#!/bin/bash
# cbase - the deploy tool: an app's VM service, static files and CloudFront distribution, from
# the app's cbase.conf (README.md "./cbase deploy tool"). It runs straight from the app's cbase
# submodule, with no build step and no provider linked:
#
#   cbase/tools/cbase config check      read cbase.conf and print it, defaults filled in (no AWS)
#   cbase/tools/cbase doctor            the config, the AWS account, each group and its members
#   cbase/tools/cbase apps [GROUP]      the apps in a group, with each one's port, service and memory
#                                       (default: cbase.conf's groups)
#   cbase/tools/cbase deploy [--dry-run] [--accept-drift] [--prune]
#                                       the app: its service on the group's VM, its static files,
#                                       its distribution. DRY_RUN=1, CBASE_ACCEPT_DRIFT=1 and
#                                       CBASE_PRUNE=1 are the same as the flags
#   cbase/tools/cbase undeploy [--delete-files] [--delete-data]
#                                       the app's service stopped and removed, its memberships left,
#                                       its stack deleted; its files and its data kept unless asked
#   cbase/tools/cbase group-init vm|static GROUP [--type TYPE] [--yes]
#                                       makes the group (an instance, or a bucket), the one command
#                                       that does; a VM's needs --yes or a typed yes (it costs money)
#   cbase/tools/cbase group-destroy vm|static GROUP [--delete-data] [--yes]
#                                       deletes an empty group's stack (refused while it has members)
#   cbase/tools/cbase template          the distribution's stack template deploy renders (no AWS;
#                                       the bucket and certificate as placeholders)
#   cbase/tools/cbase group-template vm|static GROUP   the group's stack template (no AWS)
#   cbase/tools/cbase state join|leave  the membership step deploy and undeploy run: the app
#                                       joins (or leaves) its groups' state files, a VM app
#                                       claiming its port. For repair, and for the tests.
#
# Options, before the command: -f FILE reads FILE instead of ./cbase.conf.
#
# AWS: every call is one AWS CLI call with its own credential chain (AWS_PROFILE, ~/.aws, SSO,
# the environment's keys from CI's OIDC role); the tool holds no credential and prints none.
# Never run it under `set -x` or `bash -x`.
set -euo pipefail
export LC_ALL=C
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CB_CLEANUP=()
cb_cleanup() {
  local f
  for f in "${CB_CLEANUP[@]+"${CB_CLEANUP[@]}"}"; do rm -rf "$f"; done
}
trap cb_cleanup EXIT
# shellcheck source=tools/cbase.d/conf.sh
. "$here/cbase.d/conf.sh"
# shellcheck source=tools/cbase.d/aws.sh
. "$here/cbase.d/aws.sh"
# shellcheck source=tools/cbase.d/state.sh
. "$here/cbase.d/state.sh"
# shellcheck source=tools/cbase.d/static.sh
. "$here/cbase.d/static.sh"
# shellcheck source=tools/cbase.d/stack.sh
. "$here/cbase.d/stack.sh"
# shellcheck source=tools/cbase.d/cert.sh
. "$here/cbase.d/cert.sh"
# shellcheck source=tools/cbase.d/vm.sh
. "$here/cbase.d/vm.sh"
# shellcheck source=tools/cbase.d/group.sh
. "$here/cbase.d/group.sh"
CB_TMP="$(mktemp -d "${TMPDIR:-/tmp}/cbase.XXXXXX")"
CB_CLEANUP+=("$CB_TMP")

usage() {
  sed -n '6,29p' "$here/cbase" | sed 's/^# \{0,1\}//'
}

conf="cbase.conf"
while [ $# -gt 0 ]; do
  case "$1" in
    -f) [ $# -ge 2 ] || { echo "cbase: -f wants a file" >&2; exit 2; }; conf="$2"; shift 2 ;;
    -h|--help|help) usage; exit 0 ;;
    -*) echo "cbase: unknown option $1" >&2; usage >&2; exit 2 ;;
    *) break ;;
  esac
done
[ $# -ge 1 ] || { usage >&2; exit 2; }
cmd="$1"
shift

# GROUPS: the groups cbase.conf names, "<kind> <group>" each. An array, never a loop over a pipe:
# a command in the loop (aws) would share the loop's stdin.
GROUPS_=()
conf_groups() {
  GROUPS_=()
  [ "$CONF_VM" = none ] || GROUPS_+=("vm $CONF_VM")
  [ "$CONF_STATIC" = none ] || GROUPS_+=("static $CONF_STATIC")
}

case "$cmd" in
  config)
    if [ "${1:-}" != check ] || [ $# -ne 1 ]; then echo "cbase: config check is the one config command" >&2; exit 2; fi
    conf_load "$conf"
    echo "$conf: ok"
    conf_print
    ;;
  doctor)
    [ $# -eq 0 ] || { echo "cbase: doctor takes no arguments" >&2; exit 2; }
    conf_load "$conf"
    echo "$conf: ok"
    conf_print
    aws_init
    aws_account_load
    echo "account   $AWS_ACCOUNT ($(aws_region))"
    rc=0
    conf_groups
    for g in "${GROUPS_[@]}"; do
      kind="${g%% *}"
      group="${g#* }"
      if id="$(aws_group_find "$kind" "$group")"; then
        echo "$kind group $group: $id"
        lrc=0
        state_list "$kind" "$group" || lrc=$?
        [ "$lrc" -ne 3 ] || echo "$kind group $group: no state file yet (no app has joined)"
        [ "$lrc" -eq 0 ] || [ "$lrc" -eq 3 ] || exit "$lrc"
      else
        rc=1
      fi
    done
    exit "$rc"
    ;;
  apps)
    [ $# -le 1 ] || { echo "cbase: apps takes one group name at most" >&2; exit 2; }
    if [ $# -eq 1 ]; then
      conf_name_ok "$1" || { echo "cbase: $1 is not a group name" >&2; exit 2; }
      GROUPS_=("vm $1" "static $1")
    else
      conf_load "$conf"
      conf_groups
    fi
    aws_init
    aws_account_load
    found=""
    for g in "${GROUPS_[@]}"; do
      rc=0
      state_list "${g%% *}" "${g#* }" || rc=$?
      if [ "$rc" -eq 0 ]; then found=1; elif [ "$rc" -ne 3 ]; then exit "$rc"; fi
    done
    if [ -z "$found" ]; then
      echo "cbase: no state file for $(printf '%s group, ' "${GROUPS_[@]}" | sed 's/, $//'): no app has joined it yet" >&2
      exit 1
    fi
    ;;
  state)
    op="${1:-}"
    case "$op" in join|leave) ;; *) echo "cbase: state join or state leave" >&2; exit 2 ;; esac
    [ $# -eq 1 ] || { echo "cbase: state $op takes no more arguments" >&2; exit 2; }
    conf_load "$conf"
    aws_init
    aws_account_load
    conf_groups
    for g in "${GROUPS_[@]}"; do
      aws_group_find "${g%% *}" "${g#* }" > /dev/null
      # The state file records an undeclared app's memory as the estimate it is counted at: ~128.
      mem="$CONF_MEMORY"
      [ -z "$CONF_MEMORY_ESTIMATED" ] || mem="~$CONF_MEMORY_ESTIMATE"
      state_change "${g%% *}" "${g#* }" "$CONF_APP" "$mem" "$op"
    done
    ;;
  template)
    [ $# -eq 0 ] || { echo "cbase: template takes no arguments" >&2; exit 2; }
    conf_load "$conf"
    # Placeholders where deploy puts what it finds: the static group's bucket and region, and the
    # certificate (found or requested).
    STACK_BUCKET="${CONF_STATIC}-bucket"
    STACK_BUCKET_REGION=us-east-1
    # The router's page list is the build's, when there is one to read (else empty: every
    # extensionless path is the shell).
    if [ "$CONF_STATIC" != none ] && [ -f "$CONF_STATIC_DIR/index.html" ]; then static_scan "$CONF_STATIC_DIR"; fi
    [ -z "$CONF_DOMAIN" ] || STACK_CERT="${CONF_CERT_ARN:-arn:aws:acm:us-east-1:111122223333:certificate/00000000-0000-0000-0000-000000000000}"
    STACK_API_CERT="${CONF_API_CERT_ARN:-$STACK_CERT}"
    stack_render "$CB_TMP/stack.yaml"
    echo "# PLACEHOLDERS: the bucket ($STACK_BUCKET) is static group $CONF_STATIC's${CONF_DOMAIN:+, the certificate is the one deploy finds or requests}."
    stack_print_template "$CB_TMP/stack.yaml"
    ;;
  group-template)
    kind="${1:-}"
    group="${2:-}"
    case "$kind" in vm|static) ;; *) echo "cbase: group-template vm GROUP or group-template static GROUP" >&2; exit 2 ;; esac
    if ! conf_name_ok "$group" || [ $# -ne 2 ]; then echo "cbase: group-template $kind wants one group name" >&2; exit 2; fi
    "group_render_$kind" "$group" "$CB_TMP/group.yaml"
    cat "$CB_TMP/group.yaml"
    ;;
  deploy)
    for a in "$@"; do
      case "$a" in
        --dry-run) DRY_RUN=1 ;;
        --accept-drift) CBASE_ACCEPT_DRIFT=1 ;;
        --prune) CBASE_PRUNE=1 ;;
        *) echo "cbase: deploy takes --dry-run, --accept-drift and --prune, not $a" >&2; exit 2 ;;
      esac
    done
    DRY_RUN="${DRY_RUN:-}"
    conf_load "$conf"
    aws_init
    aws_account_load
    echo "deploy: $CONF_APP to account $AWS_ACCOUNT${DRY_RUN:+ (dry run: nothing is changed)}"
    # 1. The groups, found by their tags (a missing one stops with its group-init command).
    if [ "$CONF_VM" != none ]; then
      vm_find "$CONF_VM"
    fi
    if [ "$CONF_STATIC" != none ]; then
      STACK_BUCKET="$(aws_group_find static "$CONF_STATIC")"
      STACK_BUCKET_REGION="$(aws_call s3api get-bucket-location --bucket "$STACK_BUCKET" --query LocationConstraint --output text)" \
        || aws_fail "reading s3://$STACK_BUCKET's region"
      case "$STACK_BUCKET_REGION" in None|'') STACK_BUCKET_REGION=us-east-1 ;; EU) STACK_BUCKET_REGION=eu-west-1 ;; esac
      echo "static group $CONF_STATIC: s3://$STACK_BUCKET ($STACK_BUCKET_REGION), the app's folder $CONF_APP/"
      # 2. The files, read and grouped before anything is changed.
      static_scan "$CONF_STATIC_DIR"
      static_plan "$CONF_STATIC_DIR"
    fi
    # 3. The server, built before anything is changed (a dry run builds nothing).
    [ "$CONF_VM" = none ] || [ "$DRY_RUN" = 1 ] || vm_build
    # 4. The certificate (it may stop, status 3, for DNS records added by hand).
    cert_resolve
    STACK_CERT="$CERT_ARN"
    STACK_API_CERT="$CERT_API_ARN"
    # 5. The VM group: the port claimed and the memory fit checked, in one conditional write; the
    #    stack's VM origin is the instance and that port.
    if [ "$CONF_VM" != none ]; then
      if [ "$DRY_RUN" = 1 ]; then vm_plan_dry "$CONF_VM"; else vm_join "$CONF_VM"; fi
      STACK_PARAMS=("ParameterKey=VmOrigin,ParameterValue=$VM_DNS" "ParameterKey=VmPort,ParameterValue=$VM_PORT")
    fi
    # 6. The stack's change set, through its gates (drift, the bucket).
    stack_plan
    if [ "$DRY_RUN" = 1 ]; then
      [ -z "$STACK_CHANGES" ] || stack_discard
      if [ "$CONF_STATIC" != none ]; then
        echo "the upload ($CONF_STATIC_DIR/ to s3://$STACK_BUCKET/$CONF_APP/), in order:"
        static_print_plan
      fi
      echo "dry run: change set ${STACK_CS} deleted unexecuted; nothing was uploaded, deleted or changed"
      exit 0
    fi
    # 7. The service: the artifact, then SSM installs and restarts it and waits for it to be up.
    #    It goes before the files, so a service that does not start leaves the site as it was; the
    #    change set is then deleted unexecuted.
    if [ "$CONF_VM" != none ] && ! vm_ship "$CONF_VM"; then
      [ -z "$STACK_CHANGES" ] || stack_discard
      exit 1
    fi
    # 8. The files: the app joins the static group's state file, which records its folder; then
    #    hashed, the rest, html last; then the prune, if asked.
    if [ "$CONF_STATIC" != none ]; then
      state_change static "$CONF_STATIC" "$CONF_APP" "" join
      static_print_plan
      static_upload "$STACK_BUCKET" "$STACK_BUCKET_REGION" "$CONF_APP"
      [ "${CBASE_PRUNE:-}" != 1 ] || static_prune "$STACK_BUCKET" "$STACK_BUCKET_REGION" "$CONF_APP"
    fi
    # 9. The distribution.
    [ -z "$STACK_CHANGES" ] || stack_execute
    dist_id="$(stack_output DistributionId)"
    dist_domain="$(stack_output DistributionDomain)"
    { [ -n "$dist_id" ] && [ -n "$dist_domain" ]; } || { echo "cbase: the $STACK_NAME stack has no DistributionId or DistributionDomain output" >&2; exit 1; }
    # 10. The edge's copies of the old files dropped; then the hostnames pointed at the distribution.
    if [ "$STACK_TYPE" = UPDATE ]; then   # a distribution just made has nothing cached
      inv="$(aws_call cloudfront create-invalidation --distribution-id "$dist_id" --paths '/*' --query Invalidation.Id --output text)" \
        || aws_fail "invalidating $dist_id"
      echo "invalidation $inv of /* on $dist_id"
      aws_call cloudfront wait invalidation-completed --distribution-id "$dist_id" --id "$inv" || aws_fail "waiting for invalidation $inv"
    fi
    url="https://$dist_domain/"
    if [ -n "$CERT_ARN" ]; then
      for h in "${CONF_DOMAINS[@]}"; do cert_point "$h" "$dist_domain"; done
      if [ -n "$CONF_API_HOST" ]; then
        api_domain="$(stack_output ApiDistributionDomain)"
        [ -n "$api_domain" ] || { echo "cbase: the $STACK_NAME stack has no ApiDistributionDomain output" >&2; exit 1; }
        cert_point "$CONF_API_HOST" "$api_domain"
      fi
      url="https://$CONF_DOMAIN/"
    fi
    echo "deployed $CONF_APP: $url"
    ;;
  undeploy)
    del_files=""; del_data=""
    for a in "$@"; do
      case "$a" in
        --delete-files) del_files=1 ;;
        --delete-data) del_data=1 ;;
        *) echo "cbase: undeploy takes --delete-files and --delete-data, not $a" >&2; exit 2 ;;
      esac
    done
    conf_load "$conf"
    aws_init
    aws_account_load
    echo "undeploy: $CONF_APP from account $AWS_ACCOUNT"
    # 1. The distribution first, so nothing routes to what goes next.
    STACK_NAME="$(stack_name)"
    STACK_REGION=us-east-1
    stack_delete
    # 2. The service, then its membership (its port released); its data kept unless --delete-data.
    if [ "$CONF_VM" != none ]; then
      vm_undeploy "$CONF_VM" "${del_data:-0}"
    elif [ -n "$del_data" ]; then
      echo "undeploy: --delete-data: $CONF_APP has no VM, so it has no data folder"
    fi
    # 3. The files: kept unless --delete-files (the folder alone, never another app's key).
    if [ "$CONF_STATIC" != none ]; then
      STACK_BUCKET="$(aws_group_find static "$CONF_STATIC")"
      STACK_BUCKET_REGION="$(aws_call s3api get-bucket-location --bucket "$STACK_BUCKET" --query LocationConstraint --output text)" \
        || aws_fail "reading s3://$STACK_BUCKET's region"
      case "$STACK_BUCKET_REGION" in None|'') STACK_BUCKET_REGION=us-east-1 ;; EU) STACK_BUCKET_REGION=eu-west-1 ;; esac
      if [ -n "$del_files" ]; then
        ST_FILES="$CB_TMP/no-files"
        : > "$ST_FILES"
        static_prune "$STACK_BUCKET" "$STACK_BUCKET_REGION" "$CONF_APP"
      else
        echo "undeploy: kept s3://$STACK_BUCKET/$CONF_APP/ (./cbase undeploy --delete-files deletes it)"
      fi
      state_change static "$CONF_STATIC" "$CONF_APP" "" leave
    fi
    [ -z "$CONF_DOMAIN" ] || echo "undeploy: the DNS records of ${CONF_DOMAINS[*]}${CONF_API_HOST:+ $CONF_API_HOST} still point at the deleted distribution: remove them where the domain's DNS is served"
    echo "undeployed $CONF_APP"
    ;;
  group-init|group-destroy)
    kind="${1:-}"
    group="${2:-}"
    case "$kind" in vm|static) ;; *) echo "cbase: $cmd vm GROUP or $cmd static GROUP" >&2; exit 2 ;; esac
    conf_name_ok "$group" || { echo "cbase: $cmd $kind wants a group name (a lower-case letter, then lower-case letters, digits and '-', at most 32 characters), not \"${group:0:40}\"" >&2; exit 2; }
    shift 2
    group_args "$cmd" "$@"
    aws_init
    aws_account_load
    if [ "$cmd" = group-init ]; then group_init "$kind" "$group"; else group_destroy "$kind" "$group"; fi
    ;;
  *) echo "cbase: unknown command $cmd" >&2; usage >&2; exit 2 ;;
esac
