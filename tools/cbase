#!/bin/sh
# cbase - the launcher of the deploy tool (README.md "./cbase deploy tool"). The tool is a C
# program in tools/cbase_cli/, built on first use by make (which rebuilds only what changed,
# quietly) and run with the same arguments. It has no logic of its own: its usage, commands and
# errors are the C tool's.
dir="$(cd "$(dirname "$0")" && pwd)"
if ! command -v make > /dev/null 2>&1 || ! command -v "${CC:-cc}" > /dev/null 2>&1; then
  echo "cbase: the deploy tool is C: it needs make and a C compiler (cc), as ./cbase deploy does" >&2
  exit 1
fi
make -s --no-print-directory -C "$dir/cbase_cli" > /dev/null || exit 1
exec "$dir/cbase_cli/build/cbase" "$@"
