#!/bin/bash
# The NIC interrupts' setup of cbase app shop's VM (CBASE_VM_IRQ = split), rendered by ./cbase deploy
# (tools/cbase_cli/vm_remote.py) from vm_irq_setup.sh, and run as root by SSM.
irq=split
# vm_irq_setup.sh: the NIC interrupts' setup on a group's VM, run as root by SSM after an app's deploy,
# for an app whose cbase.conf sets CBASE_VM_IRQ (vm.py sends it; an app without the key sends nothing).
# vm_remote.py renders it with irq=split or irq=irqbalance set above this text, and with
# /usr/local/sbin/cbase-irq-split (vm_irq.sh) and cbase-irq.service (vm_irq.service) spliced in at
# @CBASE_IRQ_SH@ and @CBASE_IRQ_UNIT@.
#   split:      both files written when they differ from what is installed (a daemon-reload then),
#               the unit enabled (it runs at every boot) and run now (systemctl restart: a oneshot
#               runs again, writing the same values);
#   irqbalance: the unit stopped, disabled and removed if it is there, and irqbalance enabled and
#               started: the way back.
# The interrupts are the VM's, not one app's: the last deploy that names CBASE_VM_IRQ sets them.
# It never touches an app's unit, and a failure here is reported, never fatal to the deploy.
# It prints "CBASE: " lines alone (vm.py prints those). CBASE_VM_ROOT is unset on the instance;
# cbase_vm_test.sh runs it under a scratch root with a stand-in systemctl.
# shellcheck disable=SC2154 # irq: vm_remote.py sets it
set -uo pipefail
R="${CBASE_VM_ROOT:-}"
say() { echo "CBASE: irq: $*"; }
bin="$R/usr/local/sbin/cbase-irq-split"
unitf="$R/etc/systemd/system/cbase-irq.service"

if [ "$irq" = irqbalance ]; then
  if [ -f "$unitf" ]; then
    systemctl disable --now --quiet cbase-irq.service || true
    rm -f "$unitf" "$bin"
    systemctl daemon-reload
    say "cbase-irq.service stopped, disabled and removed"
  fi
  if systemctl enable --now --quiet irqbalance.service; then
    say "irqbalance enabled and started (CBASE_VM_IRQ = irqbalance)"
  else
    say "irqbalance could not be enabled and started"
    exit 1
  fi
  exit 0
fi

mkdir -p "$R/usr/local/sbin" "$R/etc/systemd/system"
cat > "$bin.new" << 'IRQSH'
#!/bin/bash
# cbase-irq-split: one NIC queue interrupt per vCPU, with irqbalance stopped (cbase.conf CBASE_VM_IRQ =
# split). ./cbase deploy installs this file as /usr/local/sbin/cbase-irq-split, and cbase-irq.service
# (vm_irq.service, a oneshot that no app's unit depends on) runs it now and at every boot.
#
# The layout is the one measured on a t4g.nano (the foolish benchmark campaign, trips 2 and 3, "split"):
# the NIC's queue k on vCPU (k + 1) mod N and its management interrupt on vCPU 1 mod N, irqbalance
# stopped and disabled. With N queues on N vCPUs that is one queue per vCPU, the same layout at every
# boot, where irqbalance's own choices made throughput vary by about 10 percent from boot to boot.
#
# Nothing is changed, and the exit is 0, when the layout is not the expected one: no /proc/interrupts,
# not exactly one NIC with <if>-Tx-Rx-<k> queues (ENA's names), queues not numbered 0 to N-1, fewer or
# more queues than vCPUs, fewer than 2 vCPUs, or an affinity file that cannot be written. All of that
# is checked before irqbalance is touched. Should a write fail after irqbalance was stopped, irqbalance
# is started (and enabled, if it was) again and the exit is 1, so the unit shows failed. Run again, it
# writes the same values (idempotent). Every line it prints goes to the journal: journalctl -u cbase-irq.
# CBASE_VM_ROOT is unset on the instance; cbase_vm_test.sh runs it under a scratch root.
set -u
R="${CBASE_VM_ROOT:-}"
say() { echo "cbase-irq: $*"; }
leave() { say "$*: nothing changed"; exit 0; }

ints="$R/proc/interrupts"
[ -r "$ints" ] || leave "no $ints"
# The vCPUs: the CPU<n> columns of the header line.
ncpu="$(awk 'NR == 1 { n = 0; for (i = 1; i <= NF; i++) if ($i ~ /^CPU[0-9]+$/) n++; print n; exit }' "$ints")"
# The queues, "<irq> <name> <k>", one per line whose last field is <if>-Tx-Rx-<k>; and the management
# interrupt, ena-mgmnt (its last field is ena-mgmnt@pci:...). At boot the NIC's driver may not have
# made its queues yet: they are read again each second until they are as many as the vCPUs, for at
# most CBASE_IRQ_WAIT_S seconds (30; the tests set fewer), and then judged as they are.
queues_now() { awk '$NF ~ /^[A-Za-z0-9_.]+-Tx-Rx-[0-9]+$/ { irq = $1; sub(/:$/, "", irq); k = $NF; sub(/.*-Tx-Rx-/, "", k); print irq, $NF, k }' "$ints"; }
queues="$(queues_now)"
waited=0
while [ "$(grep -c . <<< "$queues")" -lt "${ncpu:-0}" ] && [ "$waited" -lt "${CBASE_IRQ_WAIT_S:-30}" ]; do
  sleep 1
  waited=$((waited + 1))
  queues="$(queues_now)"
done
[ "$waited" = 0 ] || say "waited ${waited}s for the queue interrupts"
mgmt="$(awk '$NF ~ /^ena-mgmnt/ { irq = $1; sub(/:$/, "", irq); print irq; exit }' "$ints")"
[ "${ncpu:-0}" -ge 2 ] || leave "${ncpu:-0} vCPU(s), not 2 or more"
[ -n "$queues" ] || leave "no <if>-Tx-Rx-<k> queue interrupts in /proc/interrupts"
nics="$(awk '{ n = $2; sub(/-Tx-Rx-[0-9]+$/, "", n); print n }' <<< "$queues" | sort -u | wc -l | tr -d ' ')"
[ "$nics" = 1 ] || leave "queue interrupts of $nics NICs, not one"
nq="$(wc -l <<< "$queues" | tr -d ' ')"
[ "$nq" = "$ncpu" ] || leave "$nq queue(s) on $ncpu vCPUs, not one per vCPU"
[ "$(awk '{ print $3 }' <<< "$queues" | sort -n | tr '\n' ' ')" = "$(seq 0 $((nq - 1)) | tr '\n' ' ')" ] || leave "the queues are not numbered 0 to $((nq - 1))"

# The plan, "<irq> <name> <vCPU>", every affinity file checked writable before anything changes.
plan="$(awk -v n="$ncpu" '{ print $1, $2, ($3 + 1) % n }' <<< "$queues")"
[ -z "$mgmt" ] || plan="$plan"$'\n'"$mgmt ena-mgmnt $((1 % ncpu))"
while read -r irq name cpu; do
  case "$irq" in '' | *[!0-9]*) leave "$name's interrupt number \"$irq\" is not a number" ;; esac
  [ -w "$R/proc/irq/$irq/smp_affinity_list" ] || leave "$R/proc/irq/$irq/smp_affinity_list ($name) cannot be written"
done <<< "$plan"

# irqbalance stopped and disabled first, so it does not move them again.
was_enabled=0
systemctl is-enabled --quiet irqbalance.service 2> /dev/null && was_enabled=1
systemctl stop irqbalance.service 2> /dev/null || true
systemctl disable --quiet irqbalance.service 2> /dev/null || true
n=0
while systemctl is-active --quiet irqbalance.service && [ "$n" -lt 25 ]; do sleep 0.2; n=$((n + 1)); done
undo() {
  say "$*: irqbalance started again"
  [ "$was_enabled" = 0 ] || systemctl enable --quiet irqbalance.service || true
  systemctl start irqbalance.service || true
  exit 1
}
! systemctl is-active --quiet irqbalance.service || undo "irqbalance is still running"
while read -r irq name cpu; do
  f="$R/proc/irq/$irq/smp_affinity_list"
  echo "$cpu" > "$f" || undo "writing $cpu to $f ($name) failed"
  got="$(cat "$f")"
  [ "$got" = "$cpu" ] || undo "$f ($name) reads $got after $cpu was written"
  say "$name (irq $irq) on vCPU $cpu"
done <<< "$plan"
say "one queue interrupt per vCPU ($nq queues on $ncpu vCPUs), irqbalance stopped and disabled"
IRQSH
cat > "$unitf.new" << 'IRQUNIT'
# cbase-irq.service: one NIC queue interrupt per vCPU, irqbalance stopped (cbase.conf CBASE_VM_IRQ = split;
# tools/cbase.d/vm_irq.service, installed by ./cbase deploy). It runs /usr/local/sbin/cbase-irq-split
# (tools/cbase.d/vm_irq.sh) once at every boot, after the network is online (the NIC's queue interrupts
# exist by then, and the program also waits a bounded time for them) and after irqbalance would have
# started. Nothing depends on it, and it is ordered before nothing: an app's service starts whether this
# ran, failed or was never installed. (Wants=network-online.target asks for the network, as any server
# does; it makes nothing wait for this unit.)
[Unit]
Description=cbase: one NIC queue interrupt per vCPU, irqbalance stopped (CBASE_VM_IRQ = split)
Wants=network-online.target
After=network-online.target irqbalance.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/bash /usr/local/sbin/cbase-irq-split

[Install]
WantedBy=multi-user.target
IRQUNIT
changed=""
for f in "$bin" "$unitf"; do
  if cmp -s "$f.new" "$f"; then rm -f "$f.new"; else mv "$f.new" "$f"; changed=1; fi
done
chmod 0755 "$bin"
if [ -n "$changed" ]; then
  systemctl daemon-reload
  say "cbase-irq.service and /usr/local/sbin/cbase-irq-split installed"
else
  say "cbase-irq.service and /usr/local/sbin/cbase-irq-split unchanged"
fi
systemctl enable --quiet cbase-irq.service || { say "cbase-irq.service could not be enabled"; exit 1; }
if systemctl restart cbase-irq.service; then
  say "cbase-irq.service ran (its log: journalctl -u cbase-irq)"
else
  say "cbase-irq.service failed (its log: journalctl -u cbase-irq); no app is affected"
  exit 1
fi
