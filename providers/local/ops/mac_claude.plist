<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
    Claude Code's Remote Control server on the Mac server (MAC_RUNBOOK.md), a LaunchAgent: it starts when
    automatic login opens the user's session (which unlocks the keychain that holds Claude Code's login) and
    restarts when it exits. mac_setup.sh fills in __HOME__ and installs it in ~/Library/LaunchAgents.
    script(1) gives it the terminal it expects. Its stdin is a pipe that never ends: launchd's own is /dev/null,
    whose end of file script passes on as ^D, which quits Claude Code every 30 seconds. The feeding loop is in
    the job's process group, so launchd ends it with the job. The output goes to the log.
    No session is made in advance (no-create-session-in-dir): every start, each reboot, left one more empty
    session in the app's list; a session exists once someone starts one from the app.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.cbase.mac-claude</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-c</string>
        <string>exec /usr/bin/script -q /dev/null "$0" remote-control --name "$1" --permission-mode auto --no-create-session-in-dir &lt; &lt;(while :; do sleep 86400; done)</string>
        <string>__HOME__/.local/bin/claude</string>
        <string>__NAME__</string>
    </array>
    <key>WorkingDirectory</key>
    <string>__HOME__/Dev</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>__HOME__/.local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>30</integer>
    <key>StandardOutPath</key>
    <string>__HOME__/Library/Logs/cbase-mac-claude.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/Library/Logs/cbase-mac-claude.log</string>
</dict>
</plist>
