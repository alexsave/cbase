# Build outputs (make clean removes them).
/build/
# A local database from `build/cbase` run in this directory.
/*.sqlite
/*.sqlite-wal
/*.sqlite-shm
/dist/
# ops/deploy.sh's settings and generated secrets (mode 0600). Never commit it.
/ops/.env
# The example app built as a local-only consumer (make -C example).
/example/build/
/example/storeless/build/
# What `make serve` reads and writes in its run directory: the local settings file (never commit
# it) and the default database.
/.env.local
/example/.env.local
/example/storeless/.env.local
/example/*.sqlite*
/example/storeless/*.sqlite*

# Tools built in place (tools/structgen: make -C tools/structgen).
/tools/*/build/

# Python bytecode (a mutants.py imported without PYTHONDONTWRITEBYTECODE).
__pycache__/
